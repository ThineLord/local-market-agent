# Local Market Agent defaults are deliberately paper-only.
LMA_DB_PATH=data/local_market_agent.sqlite
LMA_RAW_CACHE_DIR=data/raw_cache
LMA_RESEARCH_BRIEF_DIR=data/research_briefs

REAL_MONEY_ENABLED=false
ALLOW_LIVE_ORDERS=false
HUMAN_APPROVAL_REQUIRED=true

LMA_LLM_PROVIDER=mock
LMA_OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
LMA_OPENAI_COMPATIBLE_MODEL=local-model
LMA_OPENAI_COMPATIBLE_API_KEY=placeholder-do-not-commit-real-keys

LMA_SEC_USER_AGENT=local-market-agent@example.com
LMA_RUN_NETWORK_TESTS=false
